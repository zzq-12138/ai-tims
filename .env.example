# =====================================================================
# AI-TIMS 环境变量模板（附录 C / 任务书 10.4）
# 用法：复制为 .env 后填入真实值。.env 已被 .gitignore 排除，严禁提交。
# 注入链路：.env -> docker compose environment / systemd EnvironmentFile -> K8s Secret
# =====================================================================

# ---- MySQL 8（业务库 ai_tims，utf8mb4_0900_ai_ci）----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=ai_tims
MYSQL_USER=dev
MYSQL_PASSWORD=change-me

# ---- Redis 7（会话/缓存/在线表/去重冷却）----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- RabbitMQ 3.13（事件总线 ai-tims.event）----
RABBIT_HOST=127.0.0.1
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=change-me

# ---- Milvus standalone 2.4（向量库，embedding-3 1024 维）----
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# ---- Nacos 2.x（注册+配置中心，M1 起接入）----
NACOS_ADDR=127.0.0.1:8848
NACOS_NAMESPACE=
NACOS_USER=nacos
NACOS_PASSWORD=change-me

# ---- LLM（智谱 OpenAI 兼容协议，M5 起接入）----
LLM_API_KEY=change-me
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_CHAT_MODEL=glm-4-flash
LLM_EMBED_MODEL=embedding-3
