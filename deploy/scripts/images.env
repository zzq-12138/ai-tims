# 离线镜像清单（唯一版本来源，禁止 latest）
# 脚本用法：source deploy/scripts/images.env
# 公司仓库地址未知时保留 registry.company.internal 占位；交付前用同名环境变量覆盖。
REGISTRY_PREFIX="${REGISTRY_PREFIX:-registry.company.internal/ai-tims}"
IMAGE_TAG="${IMAGE_TAG:-1.0.0}"

# 六个业务服务（VM 构建，image 名 = ticket-*）
APP_IMAGES=(
  ticket-gateway
  ticket-system
  ticket-order
  ticket-knowledge
  ticket-ai
  ticket-push
)

# 中间件：每行「仓库内名字 上游来源镜像」，load-and-push.sh 会重打成
# ${COMPANY_REGISTRY}/ai-tims/<名字>:<tag>
UPSTREAM_IMAGES=(
  "mysql mysql:8.0.36"
  "redis redis:7-alpine"
  "rabbitmq rabbitmq:3-management"
  "nacos nacos/nacos-server:v3.0.3"
  "etcd quay.io/coreos/etcd:v3.5.14"
  "minio milvusdb/minio:RELEASE.2024-05-28T17-19-04Z"
  "milvus milvusdb/milvus:v2.4.15"
)
