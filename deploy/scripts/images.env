# 离线镜像清单（唯一版本来源，禁止 latest）
# 脚本用法：source deploy/scripts/images.env
# 仓库已确定：harbor.xnunion.com/library（172.27.18.160，仅 HTTP，
# 已进各节点 daemon.json 的 insecure-registries）。
REGISTRY_PREFIX="${REGISTRY_PREFIX:-harbor.xnunion.com/library}"
IMAGE_TAG="${IMAGE_TAG:-1.0.0}"

# 七个业务镜像（VM 构建，image 名 = ticket-* / ai-tims-front）
APP_IMAGES=(
  ticket-gateway
  ticket-system
  ticket-order
  ticket-knowledge
  ticket-ai
  ticket-push
  ai-tims-front
)

# 中间件：每行「仓库内名字 上游来源镜像」，load-and-push.sh 会重打成
# ${REGISTRY_PREFIX}/<名字>:<tag>
# 已推送：rabbitmq / etcd / milvus / minio（仓库内为 tims-* 命名）
# 未推送：redis（清单已指向 tims-redis，补推前会 ImagePullBackOff）
# MySQL / Nacos 已改用公司公共实例，不再由本套清单部署
UPSTREAM_IMAGES=(
  "tims-rabbitmq rabbitmq:3-management"
  "tims-etcd quay.io/coreos/etcd:v3.5.14"
  "tims-milvus milvusdb/milvus:v2.4.15"
  "tims-minio milvusdb/minio:RELEASE.2024-05-28T17-19-04Z"
  "tims-redis redis:7-alpine"
)
