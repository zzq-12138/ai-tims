{
  "version": "det-trigger-v1",
  "frozen_at": "2026-11-10T12:30:19+08:00",
  "frozen_scope": "det_trigger.py：数字抽取 + 7 算子枚举 + 三档判定 + 覆盖选择",
  "not_in_scope": [
    "det_trigger_eval.py",
    "tool_calc_eval.py",
    "bare_eval.py"
  ],
  "tol": 0.06,
  "limits": {
    "max_src_numbers": 14,
    "max_candidates": 4000,
    "max_stage1": 40
  },
  "ops": [
    "difference",
    "delta_percent",
    "pct_of",
    "count_over",
    "count_in_range",
    "ratio",
    "average"
  ],
  "ops_impl": "直接复用 tool_calc.run_calculation，不另写算术",
  "enumeration_rules": [
    "rank1 带标签数字对（上月/本月、上周/这周、从…调到、原来/现在、计划/实际、下限/上限、上批/这批）：两两枚举 difference / delta_percent / pct_of / ratio",
    "rank2 数值列表（≥4 个数、以、，,和 连接）：average；配合阈值枚举 count_over 与其补集；配合区间枚举 count_in_range 与其补集；并给出对应的 count/n*100 占比与补集占比",
    "rank3 全部数字两两组合：同上四个算子",
    "rank2 二段复算：rank≤2 的中间结果（前 40 个）与题面数字再做 difference / delta_percent / pct_of",
    "题面出现「成」时，为每个 delta_percent 追加 ×0.1 的成数变体",
    "所有结果按 (op, 四位小数) 去重；候选上限 4000"
  ],
  "judge_rules": [
    "答案中的数字若能在题面/资料原文找到（±0.06）→ 视为事实性回答，accept",
    "答案中的数字若能被候选集解释（±0.06）→ accept（recomputed）",
    "有数字既非原文也非候选，且候选集非空 → conflict（覆盖或升级）",
    "有数字既非原文也非候选，且候选集为空 → uncomputable（升级）"
  ],
  "cue_rules": [
    [
      "几成",
      [
        "delta_percent_x10"
      ],
      "成数"
    ],
    [
      "(?:多|少|高|低|增加|减少|增长|下降|上升|提升|降低)了?百分之几",
      [
        "delta_percent"
      ],
      "变化率"
    ],
    [
      "(?:几个?百分点|百分点)",
      [
        "delta_percent"
      ],
      "百分点"
    ],
    [
      "(?:平均|均值)",
      [
        "average"
      ],
      "均值"
    ],
    [
      "(?:超(?:过|了几)|超标|几回|几次超|越线)",
      [
        "count_over"
      ],
      "超阈值计数"
    ],
    [
      "(?:不合格|不达标)",
      [
        "ratio",
        "count_in_range_not",
        "count_over_not"
      ],
      "不合格数/率"
    ],
    [
      "(?:合格|落在|区间|范围)",
      [
        "count_in_range"
      ],
      "区间计数"
    ],
    [
      "(?:占比|占多少|占百分之|百分之几|比例)",
      [
        "ratio",
        "pct_of"
      ],
      "占比"
    ],
    [
      "(?:差多少|相差|高多少|低多少|还差|缺口|少了多少|多了多少)",
      [
        "difference"
      ],
      "差值"
    ]
  ],
  "threshold_patterns": [
    "(?:不超过|不高于|不得超过|要求不超过|超过|高于|大于|上限为|上限)\\s*(?:为|是)?\\s*(\\d+(?:\\.\\d+)?)",
    "(?:不低于|不小于|低于|小于|下限为|下限)\\s*(?:为|是)?\\s*(\\d+(?:\\.\\d+)?)"
  ],
  "range_patterns": [
    "(?:合格范围|工艺范围|允许范围|范围)\\s*(?:为|是)?\\s*(\\d+(?:\\.\\d+)?)\\s*[-~～至]\\s*(\\d+(?:\\.\\d+)?)",
    "(?:要求|标准|规格|工艺|限|落在|控制在|保持)\\s*(?:在)?\\s*(\\d+(?:\\.\\d+)?)\\s*[-~～至]\\s*(\\d+(?:\\.\\d+)?)",
    "(?<![\\d.])(\\d+(?:\\.\\d+)?)\\s*[-~～]\\s*(\\d+(?:\\.\\d+)?)(?![\\d.])",
    "(\\d+(?:\\.\\d+)?)\\s*[~～至]\\s*(\\d+(?:\\.\\d+)?)\\s*(?:之间|以内|范围内)"
  ],
  "pair_patterns": [
    [
      "上(?:个)?月(?:份)?.{0,10}?(\\d+(?:\\.\\d+)?).{0,16}?(?:本|这个)月.{0,10}?(\\d+(?:\\.\\d+)?)",
      "上月/本月"
    ],
    [
      "上周.{0,10}?(\\d+(?:\\.\\d+)?).{0,16}?(?:这周|本周|今天|这次|本次).{0,10}?(\\d+(?:\\.\\d+)?)",
      "上周/这周"
    ],
    [
      "从\\s*(\\d+(?:\\.\\d+)?)\\s*.{0,6}?(?:调到|降到|升到|变成|改为)\\s*(\\d+(?:\\.\\d+)?)",
      "从…调到…"
    ],
    [
      "(?:原来|原值|初始|首次|首测|昨天|此前).{0,8}?(\\d+(?:\\.\\d+)?).{0,16}?(?:现在|当前|现值|复测|今天|本次).{0,8}?(\\d+(?:\\.\\d+)?)",
      "原值/现值"
    ],
    [
      "计划.{0,8}?(\\d+(?:\\.\\d+)?).{0,16}?实际(?:完成)?.{0,8}?(\\d+(?:\\.\\d+)?)",
      "计划/实际"
    ],
    [
      "(?:下限|最低).{0,8}?(\\d+(?:\\.\\d+)?).{0,16}?(?:上限|最高).{0,8}?(\\d+(?:\\.\\d+)?)",
      "下限/上限"
    ],
    [
      "上一?批.{0,10}?(\\d+(?:\\.\\d+)?).{0,16}?这(?:一)?批.{0,10}?(\\d+(?:\\.\\d+)?)",
      "上批/这批"
    ]
  ],
  "det_trigger_sha256": "49ddd2d24deacff917794d46425604706f941d5f3e28cc58073d5a8e21dc9f25",
  "tool_calc_sha256": "a0cab12307411d2658e3b448df4490484afe951a4e5761af2204ec242665a82d",
  "escalation": "glm-5.3-flash；与「全大模型」组同一调用口径（temperature 0.3、max_tokens 8192），费用与延迟按该次调用实际用量计",
  "protocol": "冻结之后才生成 Holdout-3；Holdout-3 只跑一次；不回改任何规则；机械故障可修脚本重跑，但须注明「工程故障，非口径修改」"
}
