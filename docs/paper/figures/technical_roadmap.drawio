<mxfile host="app.diagrams.net" type="device">
  <diagram name="技术路线图" id="roadmap-1">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="entry" value="工单关闭事件" style="text;html=1;align=center;verticalAlign=middle;fontFamily=SimSun;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="400" y="95" width="580" height="40" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="&lt;b&gt;分步抽取&lt;/b&gt;&lt;br&gt;现象 → 根因 → 措施 → 验证 → 条件&lt;br&gt;另设反向项：排除过哪些可能、有无最终结论" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=SimSun;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="230" width="580" height="170" as="geometry" />
        </mxCell>

        <mxCell id="b2" value="&lt;b&gt;证据校验门&lt;/b&gt;&lt;br&gt;格式校验、证据回溯、反向项核验&lt;br&gt;未过即停，标记证据不足并留空" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=SimSun;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="485" width="580" height="170" as="geometry" />
        </mxCell>

        <mxCell id="b3" value="&lt;b&gt;条件字段化&lt;/b&gt;&lt;br&gt;设备型号 · 工艺段 · 材料或批次&lt;br&gt;参数区间 · 前置状态" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=SimSun;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="740" width="580" height="170" as="geometry" />
        </mxCell>

        <mxCell id="b4" value="&lt;b&gt;条件判别与去重&lt;/b&gt;&lt;br&gt;该合并 / 不该合并&lt;br&gt;事实冲突 / 条件冲突" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=SimSun;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="995" width="580" height="170" as="geometry" />
        </mxCell>

        <mxCell id="b5" value="&lt;b&gt;三档门控&lt;/b&gt;&lt;br&gt;A 正常推送 · B 仅供参考 · C 不推送" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=SimSun;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="1250" width="580" height="170" as="geometry" />
        </mxCell>

        <mxCell id="b6" value="&lt;b&gt;知识入库与推送&lt;/b&gt;&lt;br&gt;带条件、可追溯&lt;br&gt;按条件过滤后推送" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontFamily=SimSun;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="400" y="1505" width="580" height="170" as="geometry" />
        </mxCell>

        <mxCell id="branch" value="&lt;b&gt;阈值定参与跨库迁移复核&lt;/b&gt;&lt;br&gt;小库定参、大库复核&lt;br&gt;失效即判不可迁移" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1;fontFamily=SimSun;fontSize=11;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1150" y="1265" width="450" height="140" as="geometry" />
        </mxCell>

        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.5;" edge="1" parent="1" source="entry" target="b1">
