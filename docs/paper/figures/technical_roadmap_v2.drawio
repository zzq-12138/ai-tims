<mxfile host="app.diagrams.net" type="device">
  <diagram name="技术路线图v2" id="roadmap-v2">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="entry" value="工单关闭事件" style="text;html=1;align=center;verticalAlign=middle;fontFamily=SimSun;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="330" y="110" width="620" height="44" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="&lt;b&gt;分步抽取&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;现象 → 根因 → 措施 → 验证 → 条件&lt;br&gt;另设反向项：排除过哪些可能、有无最终结论&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.6;fontFamily=SimSun;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="330" y="200" width="620" height="190" as="geometry" />
        </mxCell>

        <mxCell id="b2" value="&lt;b&gt;证据校验门&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;格式校验、证据回溯、反向项核验&lt;br&gt;未过即停，标记证据不足并留空&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#000000;strokeWidth=1.6;fontFamily=SimSun;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="330" y="460" width="620" height="190" as="geometry" />
        </mxCell>

        <mxCell id="b3" value="&lt;b&gt;条件字段化&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;设备型号 · 工艺段 · 材料或批次&lt;br&gt;参数区间 · 前置状态&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.6;fontFamily=SimSun;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="330" y="720" width="620" height="190" as="geometry" />
        </mxCell>

        <mxCell id="b4" value="&lt;b&gt;条件判别与去重&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;该合并 / 不该合并&lt;br&gt;事实冲突 / 条件冲突&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.6;fontFamily=SimSun;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="330" y="980" width="620" height="190" as="geometry" />
        </mxCell>

        <mxCell id="b5" value="&lt;b&gt;三档门控&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A 正常推送 · B 仅供参考 · C 不推送&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#000000;strokeWidth=1.6;fontFamily=SimSun;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="330" y="1240" width="620" height="190" as="geometry" />
        </mxCell>

        <mxCell id="b6" value="&lt;b&gt;知识入库与推送&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;带条件、可追溯&lt;br&gt;按条件过滤后推送&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.6;fontFamily=SimSun;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="330" y="1500" width="620" height="190" as="geometry" />
        </mxCell>

        <mxCell id="branch" value="&lt;b&gt;阈值定参&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;小库定参、大库复核&lt;br&gt;失效即判不可迁移&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A0A0A0;dashed=1;strokeWidth=1.2;fontFamily=SimSun;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1290" y="1260" width="390" height="150" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="虚线为回环校验" style="text;html=1;align=left;verticalAlign=middle;fontFamily=SimSun;fontSize=11;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="412" y="1724" width="220" height="32" as="geometry" />
        </mxCell>
        <mxCell id="legendline" style="endArrow=none;html=1;strokeColor=#A0A0A0;strokeWidth=1.2;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="330" y="1740" as="sourcePoint" />
            <mxPoint x="394" y="1740" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="e0" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.6;" edge="1" parent="1" source="entry" target="b1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.6;" edge="1" parent="1" source="b1" target="b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.6;" edge="1" parent="1" source="b2" target="b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.6;" edge="1" parent="1" source="b3" target="b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.6;" edge="1" parent="1" source="b4" target="b5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#000000;strokeWidth=1.6;" edge="1" parent="1" source="b5" target="b6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#A0A0A0;strokeWidth=1.2;" edge="1" parent="1" source="branch" target="b5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
