<mxfile host="app.diagrams.net" type="device">
  <diagram name="技术路线图v3" id="roadmap-v3">
    <mxGraphModel dx="1200" dy="800" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="entry" value="工单关闭事件" style="text;html=1;align=center;verticalAlign=middle;fontFamily=SimSun;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="170" y="58" width="860" height="56" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="&lt;b style=&quot;font-size:13px&quot;&gt;分步抽取&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;现象 → 根因 → 措施 → 验证 → 条件&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontFamily=SimSun;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="170" y="140" width="860" height="170" as="geometry" />
        </mxCell>

        <mxCell id="b2" value="&lt;b style=&quot;font-size:13px&quot;&gt;证据校验门&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;格式 / 证据回溯 / 反向项&lt;br&gt;未过即停 · 证据不足留空&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#000000;strokeWidth=1.2;fontFamily=SimSun;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="170" y="356" width="860" height="170" as="geometry" />
        </mxCell>

        <mxCell id="b3" value="&lt;b style=&quot;font-size:13px&quot;&gt;条件字段化&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;型号 · 工艺段 · 材料或批次&lt;br&gt;参数区间 · 前置状态&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontFamily=SimSun;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="170" y="572" width="860" height="170" as="geometry" />
        </mxCell>

        <mxCell id="b4" value="&lt;b style=&quot;font-size:13px&quot;&gt;条件判别与去重&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;该合并 / 不该合并&lt;br&gt;事实冲突 / 条件冲突&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontFamily=SimSun;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="170" y="788" width="860" height="170" as="geometry" />
        </mxCell>

        <mxCell id="b5" value="&lt;b style=&quot;font-size:13px&quot;&gt;三档门控&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;A 推送 · B 仅供参考 · C 不推送&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#000000;strokeWidth=1.2;fontFamily=SimSun;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="170" y="1004" width="860" height="170" as="geometry" />
        </mxCell>

        <mxCell id="b6" value="&lt;b style=&quot;font-size:13px&quot;&gt;知识入库与推送&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;带条件、可追溯&lt;br&gt;按条件过滤后推送&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.2;fontFamily=SimSun;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="170" y="1220" width="860" height="170" as="geometry" />
        </mxCell>

        <mxCell id="branch" value="&lt;b style=&quot;font-size:12px&quot;&gt;阈值定参&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;小库定参、大库复核&lt;br&gt;失效即判不可迁移&lt;/font&gt;" style="rounded=1;arcSize=9;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A0A0A0;dashed=1;strokeWidth=1;fontFamily=SimSun;align=center;verticalAlign=middle;" vertex="1" parent="1">
