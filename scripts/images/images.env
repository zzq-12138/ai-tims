#!/usr/bin/env bash
# =====================================================================
# AI-TIMS 离线镜像交付 - 统一配置（四个脚本全部从这里读，不要在脚本里改值）
# =====================================================================

# 应用版本号（禁止 latest / 空值；每次交付由发布负责人统一定义）
APP_VERSION=0.3.0

# 本地镜像命名空间（VM 上 docker images 里看到的 tims/xxx）
IMAGE_NAMESPACE=tims

# 公司镜像仓库前缀，例如：registry.corp.example.com/tims
# 留空 = 只做 load/tag 的 dry-run（不会真正 push）
# 公司侧使用人填好后，load-images.sh 会自动把镜像 tag 到公司仓库，push-images.sh 才允许执行
REGISTRY_PREFIX=

# 目标集群架构（公司集群为 amd64；VM 构建与 save 均显式指定，禁止改动）
PLATFORM=linux/amd64

# 后端服务列表（与 ai-tims-parent 下的模块名一致）
SERVICES="ticket-gateway ticket-order ticket-knowledge ticket-system ticket-push ticket-ai"

# 前端镜像名（多阶段构建：node 编译 + nginx 托管）
FRONT_IMAGE_NAME=ai-tims-front

# 基础镜像（VM 上一次拉取，save 时一并打进 tar，公司侧不依赖外网）
BACKEND_BASE_IMAGE=eclipse-temurin:17-jre-alpine
FRONT_BASE_IMAGE=nginx:1.27-alpine

# save 产物输出目录（VM 侧，tar 与 sha256 校验文件落在这里）
OUT_DIR_DEFAULT="$HOME/image-delivery"
